let timeframe = 24h;
let amlJobReads =
    AzureActivity
    | where TimeGenerated > ago(timeframe)
    | where ResourceProviderValue =~ "MICROSOFT.MACHINELEARNINGSERVICES"
    | where OperationNameValue has "WORKSPACES/JOBS/READ"
        or OperationName has "WORKSPACES/JOBS/READ"
        or ResourceId has "/providers/Microsoft.MachineLearningServices/workspaces/" and ResourceId has "/jobs"
        | project JobReadTime = TimeGenerated, Caller, CallerIpAddress, ResourceId, CorrelationId;
let amlLogBlobReads =
    StorageBlobLogs
    | where TimeGenerated > ago(timeframe)
    | where OperationName == "GetBlob" and StatusText == "Success"
    | where Uri has_any ("azureml", "ExperimentRun", "dcid.", "logs", "std_log", "user_logs")
    | project BlobReadTime = TimeGenerated, AccountName, CallerIpAddress, Uri, UserAgentHeader;
amlJobReads
| join kind=leftouter amlLogBlobReads on CallerIpAddress
| where isnull(BlobReadTime) or BlobReadTime between ((JobReadTime - 30m) .. (JobReadTime + 30m))
| summarize
    JobReadCount = count(),
    FirstSeen = min(JobReadTime),
    LastSeen = max(JobReadTime),
    Resources = make_set(ResourceId, 50),
    BlobUris = make_set(Uri, 50),
    UserAgents = make_set(UserAgentHeader, 20)
    by Caller, CallerIpAddress
| where JobReadCount >= 5 or array_length(BlobUris) > 0
| project FirstSeen, LastSeen, Caller, CallerIpAddress, JobReadCount, Resources, BlobUris, UserAgents
| order by LastSeen desc
