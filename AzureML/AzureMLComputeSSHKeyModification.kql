let timeframe = 24h;
let computeControlPlaneOps = dynamic([
    "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/READ",
    "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/START/ACTION",
    "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/STOP/ACTION",
    "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/UPDATESSHPUBLICKEY/ACTION"
]);
AzureActivity
| where TimeGenerated > ago(timeframe)
| where ResourceProviderValue =~ "MICROSOFT.MACHINELEARNINGSERVICES"
| where toupper(OperationNameValue) in (computeControlPlaneOps)
    or toupper(OperationName) in (computeControlPlaneOps)
    or OperationNameValue has_any ("updateSshPublicKey", "start", "stop")
| extend Operation = toupper(coalesce(OperationNameValue, OperationName))
| summarize
    OperationCount = count(),
    Operations = make_set(Operation, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    Resources = make_set(ResourceId, 20)
    by Caller, CallerIpAddress, CorrelationId
| where set_has_element(Operations, "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/UPDATESSHPUBLICKEY/ACTION")
    or array_length(set_intersect(Operations, dynamic([
        "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/START/ACTION",
        "MICROSOFT.MACHINELEARNINGSERVICES/WORKSPACES/COMPUTES/STOP/ACTION"
    ]))) >= 2
| project FirstSeen, LastSeen, Caller, CallerIpAddress, OperationCount, Operations, Resources, CorrelationId
| order by LastSeen desc
